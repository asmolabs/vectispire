{
    "name": "@vectispire/frontend",
    "version": "0.9.0",
    "private": true,
    "license": "Apache-2.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve --port 4280",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "format": "prettier --write \"src/**/*.{ts,html,scss,css}\" --cache",
        "lint": "eslint src",
        "test": "node scripts/check-assets.mjs && node scripts/check-i18n-keys.mjs && node scripts/check-dead-api-methods.mjs && ng test",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "generate:api": "openapi-typescript openapi.json -o src/app/core/api.generated.ts"
    },
    "dependencies": {
        "@angular/cdk": "^22",
        "@angular/common": "^22",
        "@angular/compiler": "^22",
        "@angular/core": "^22",
        "@angular/forms": "^22",
        "@angular/platform-browser": "^22",
        "@angular/router": "^22",
        "@openng/optimus-ui": "^2.0.2",
        "@openng/optimus-ui-themes": "^2.0.2",
        "@tailwindcss/postcss": "^4.1.11",
        "chart.js": "4.5.1",
        "primeicons": "7.0.0",
        "rxjs": "~7.8.0",
        "tailwindcss-primeui": "^0.6.1",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@angular/build": "^22",
        "@angular/cli": "^22",
        "@angular/compiler-cli": "^22",
        "@playwright/test": "^1.63.0",
        "angular-eslint": "^22.5.0",
        "autoprefixer": "^10.6.1",
        "eslint": "^9.39.5",
        "jsdom": "^26.1.0",
        "openapi-typescript": "^7.13.0",
        "postcss": "^8.5.28",
        "prettier": "^3.9.9",
        "tailwindcss": "^4.1.11",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.1",
        "vitest": "^4.1.10"
    }
}
