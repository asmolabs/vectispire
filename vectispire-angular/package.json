{
    "name": "@vectispire/frontend",
    "version": "0.11.2",
    "private": true,
    "license": "Apache-2.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve --port 4280",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "format": "prettier --write \"src/**/*.{ts,html,scss,css}\" \"e2e/**/*.ts\" playwright.config.ts --cache",
        "format:check": "prettier --check \"src/**/*.{ts,html,scss,css}\" \"e2e/**/*.ts\" playwright.config.ts",
        "lint": "eslint src e2e playwright.config.ts && tsc -p tsconfig.e2e.json",
        "test": "node scripts/check-assets.mjs && node scripts/check-i18n-keys.mjs && node scripts/check-dead-api-methods.mjs && node scripts/check-icon-buttons.mjs && node scripts/check-spec-types.mjs && node scripts/check-test-floor.mjs",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "generate:api": "openapi-typescript openapi.json -o src/app/core/api.generated.ts"
    },
    "dependencies": {
        "@angular/cdk": "^22",
        "@angular/common": "^22",
        "@angular/compiler": "^22",
        "@angular/core": "^22",
        "@angular/forms": "^22",
        "@angular/platform-browser": "^22",
        "@angular/router": "^22",
        "@openng/icons": "1.0.0",
        "@openng/optimus-ui": "^2.0.2",
        "@openng/optimus-ui-tailwindcss": "^2.0.2",
        "@openng/optimus-ui-themes": "^2.0.2",
        "@tailwindcss/postcss": "^4.1.11",
        "chart.js": "4.6.1",
        "rxjs": "~7.8.0",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@angular/build": "^22",
        "@angular/cli": "^22",
        "@angular/compiler-cli": "^22",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "@vitest/coverage-v8": "^4.1.12",
        "angular-eslint": "^22.5.0",
        "autoprefixer": "^10.6.2",
        "eslint": "^10.13.0",
        "happy-dom": "^20.14.6",
        "mysql2": "3.24.6",
        "openapi-typescript": "^7.13.0",
        "postcss": "^8.5.32",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.1.11",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^4.1.12"
    }
}
