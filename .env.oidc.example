# Connexion déléguée. Copiez ce fichier en `.env.oidc` pour l'activer ; absent, Vectispire
# n'expose aucune connexion par fournisseur et le mot de passe local reste la seule porte.
#
# Ces valeurs correspondent au Keycloak du profil `sso` :
#   docker compose --profile sso up
#
# L'issuer est vu **depuis le conteneur du plan de contrôle**, d'où le nom de service et non
# `localhost` — une erreur qui se paie par un échec de découverte au démarrage.
VECTISPIRE_OIDC_ISSUER=http://keycloak:8080/realms/vectispire
VECTISPIRE_OIDC_CLIENT_ID=vectispire
VECTISPIRE_OIDC_CLIENT_SECRET=evaluation-only-not-a-secret
VECTISPIRE_OIDC_NAME=Keycloak

# Une fois la connexion déléguée vérifiée, fermez la porte du mot de passe. Refusé, à voix
# haute, tant qu'aucun fournisseur n'est configuré : fermer la seule porte qui marche
# verrouillerait tout le monde dehors.
# VECTISPIRE_PASSWORD_LOGIN=false
