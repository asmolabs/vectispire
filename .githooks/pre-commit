#!/usr/bin/env bash
#
# Vectispire pre-commit hook:
# Automatically computes and updates dependency lockfiles whenever build configurations change.
#

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Staged files in this commit
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

# 1. Check if any Gradle build/dependency files were modified
GRADLE_CHANGED=$(echo "$STAGED_FILES" | grep -E 'vectispire-java/.*(\.gradle\.kts|libs\.versions\.toml|gradle\.properties)$' || true)

if [ -n "$GRADLE_CHANGED" ]; then
    echo "⚡ [pre-commit] Gradle build configuration change detected. Recalculating dependency write-locks..."
    (
        cd "$REPO_ROOT/vectispire-java"
        # Locks are written; verification metadata is not, on purpose: it is where trust is
        # extended, so it is regenerated by hand and its diff read (vectispire-java/README.md).
        # **Every module named.** `--write-locks` alone, or with `dependencies` and no path,
        # resolves the root project only — `dependencies` is a help task and does not descend —
        # so the modules' lockfiles were never rewritten: Dependabot's ArchUnit bump (#24)
        # failed on a lock still at 1.5.0 although this hook had "updated and staged" it. A
        # module is a directory with a build script, so a new one is covered without editing
        # this file.
        tasks=(dependencies)
        for script in */build.gradle.kts; do tasks+=(":${script%%/*}:dependencies"); done
        ./gradlew "${tasks[@]}" --write-locks -q >/dev/null || {
            echo "❌ [pre-commit] Gradle failed. If it names artifacts that failed dependency verification," >&2
            echo "   run vectispire-java/gradle/update-verification-metadata.sh and review its diff." >&2
            exit 1
        }
    )
    # Stage any updated lockfiles
    git add "$REPO_ROOT"/vectispire-java/**/gradle.lockfile "$REPO_ROOT"/vectispire-java/*.lockfile 2>/dev/null || true
    echo "✅ [pre-commit] Gradle dependency lockfiles updated and staged."
fi

# 2. Check if package.json was modified
NPM_CHANGED=$(echo "$STAGED_FILES" | grep -E '(^|/)package\.json$' || true)
LOCK_STAGED=$(echo "$STAGED_FILES" | grep -E '^package-lock\.json$' || true)

# **A lockfile the author staged is left as staged.** `npm install --package-lock-only` does not
# only sync: npm 11 also drops some thirty `"peer": true` markers on every run, unrelated to the
# change, and this hook restaged them over the hand-kept lockfile of the Sparked plugin swap on
# 2026-10-01. Syncing is for a package.json edited without its lockfile.
if [ -n "$NPM_CHANGED" ] && [ -n "$LOCK_STAGED" ]; then
    echo "ℹ️  [pre-commit] package-lock.json is staged with package.json: left as staged."
elif [ -n "$NPM_CHANGED" ]; then
    echo "⚡ [pre-commit] package.json change detected. Synchronizing package-lock.json..."
    # **On the Node `.nvmrc` pins**, not whatever the shell has: under the system's Node 25 the
    # sync ran with engine warnings on every Angular package. nvm when it is there; otherwise
    # refuse a different major rather than write a lockfile with the wrong toolchain.
    if [ -s "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ]; then
        . "${NVM_DIR:-$HOME/.nvm}/nvm.sh" && nvm use --silent >/dev/null
    fi
    if [ "$(node -p 'process.versions.node.split(".")[0]')" != "$(tr -d 'v \n' < .nvmrc | cut -d. -f1)" ]; then
        echo "❌ [pre-commit] Node $(node -v) is not the major .nvmrc pins ($(cat .nvmrc)); run 'nvm use' and commit again." >&2
        exit 1
    fi
    npm install --package-lock-only --ignore-scripts
    git add "$REPO_ROOT/package-lock.json"
    echo "✅ [pre-commit] package-lock.json updated and staged."
fi

exit 0
