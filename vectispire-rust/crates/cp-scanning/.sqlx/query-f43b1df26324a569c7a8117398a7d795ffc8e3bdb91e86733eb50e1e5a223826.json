  "query": "/* postgres */ select id, type as kind, severity, identifier, package_name, package_version, fix_versions, file_path, line, description, link, tool, tool_name, tool_version from t_finding where scan_id = $1 order by case severity when 'critical' then 0 when 'high' then 1 when 'medium' then 2 when 'low' then 3 when 'negligible' then 4 else 5 end asc, id asc limit $2",
