  "query": "/* postgres */ select s.repo_id as \"repo_id!\", count(s.id) as \"completed!\", coalesce(sum(case when s.examined_types is null then 1 else 0 end), 0) as \"unrecorded!\" from t_scan s where s.repo_id = any($1) and s.status = $2 and s.created_at >= $3 group by s.repo_id",
