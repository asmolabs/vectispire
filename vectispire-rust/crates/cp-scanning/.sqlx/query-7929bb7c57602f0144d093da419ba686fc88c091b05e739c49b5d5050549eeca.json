  "query": "/* mysql */ select s.repo_id as \"repo_id!\", s.id, s.created_at as \"created_at: UtcInstant\", case when s.sbom is null then 0 else 1 end as \"sbom_stored!: i64\" from t_scan s where s.repo_id in (select j.id from json_table(?, '$[*]' columns (id bigint path '$')) as j) and s.id = (select max(l.id) from t_scan l where l.repo_id = s.repo_id and l.status = ? and l.created_at >= ? and concat(',', l.examined_types, ',') like ?)",
