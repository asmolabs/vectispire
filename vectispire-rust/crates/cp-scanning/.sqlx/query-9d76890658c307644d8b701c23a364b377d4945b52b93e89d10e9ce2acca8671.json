{
  "db_name": "PostgreSQL",
  "query": "/* postgres */ select s.repo_id as \"repo_id!\", s.id, s.created_at as \"created_at: UtcInstant\", (s.sbom is not null) as \"sbom_stored!\" from t_scan s where s.repo_id = any($1) and s.id = (select max(l.id) from t_scan l where l.repo_id = s.repo_id and l.status = $2 and l.created_at >= $3 and (',' || l.examined_types || ',') like $4)",
