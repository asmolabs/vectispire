  "query": "/* mysql */ select i.repo_id as \"repo_id!\", i.severity, i.state, count(i.id) as \"count!: i64\" from t_issue i where i.repo_id in (select j.id from json_table(?, '$[*]' columns (id bigint path '$')) as j) and i.type = ? and i.triage_status not in (?, ?, ?) group by i.repo_id, i.severity, i.state",
