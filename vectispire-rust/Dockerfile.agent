# The Rust agent's image — port in progress, not shipped: built for the Phase 0 measurements
# (README.md) and the image stream's starting point, not published by release.yml.
#
# A static musl binary on `scratch`: no shell, no package manager, no `git` or `ssh` binary, no
# system certificate store (the authorities are compiled in; VECTISPIRE_TLS_CA_BUNDLE replaces them).
FROM rust:1.99.1-alpine3.22@sha256:2b3b5cdd9112f19366d21b94541ffcd3d58bf838f696451a0d50c8032088cb15 AS build
# libssh2's vendored OpenSSL is built from source: a compiler, perl and make. cargo-auditable writes
# the dependency list into the binary, which is what lets Syft and Grype see what a static binary
# links — without it they find no package, and "no vulnerability" would mean "nothing looked at".
RUN apk add --no-cache musl-dev perl make linux-headers \
 && cargo install --locked cargo-auditable@0.7.4
WORKDIR /src
COPY . .
# The musl targets link statically by default; asking for it in RUSTFLAGS would also apply it to the
# proc-macros, which then cannot be built.
ENV SOURCE_DATE_EPOCH=0 \
    RUSTFLAGS="--remap-path-prefix=/src=. --remap-path-prefix=/usr/local/cargo=cargo"
RUN cargo auditable build --release --locked -p vectispire-agent \
 && cp target/release/vectispire-agent /vectispire-agent

FROM scratch
# checkov:skip=CKV_DOCKER_2: the agent listens on nothing — it reaches the control plane by outbound
# long-polling (decision 0003) — so there is no port to probe, and `scratch` holds no program to run.
COPY --from=build /vectispire-agent /vectispire-agent
USER 1000:1000
ENTRYPOINT ["/vectispire-agent"]
