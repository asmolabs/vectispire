# The Rust agent's image — port in progress, not shipped, and not signed by release.yml until the
# side-by-side conformance has held (README.md, "Image and side-by-side conformance").
#
# A static musl binary on `scratch`: no shell, no package manager, no `git` or `ssh` binary, no
# system certificate store (the authorities are compiled in; VECTISPIRE_TLS_CA_BUNDLE replaces them).
#
# **Built twice from nothing, the same image** (`security/reproducible-image.sh`, per platform):
# everything that reaches the binary — rustc, musl, gcc and binutils — comes from the builder pinned by
# its index digest, which covers linux/amd64 and linux/arm64; each platform is built natively (CI's arm
# runner for arm64), never cross-compiled, so one Dockerfile and no second toolchain.
#
# **A drop-in for the Java agent's image** (Jib, `vectispire-agent/build.gradle.kts`): the same user
# 1000:1000, the same `HOME=/home/vectispire` writable by it, and a `/tmp` as on the JRE's Alpine base,
# for a plain `docker run` that names no work directory. The work directory and the home a deployment
# sets are read where the Java agent reads them — `VECTISPIRE_WORK_DIR`, else the `-Djava.io.tmpdir=` and
# `-Duser.home=` of `JDK_JAVA_OPTIONS` (the composition's and the chart's), else `TMPDIR` and `HOME` —
# and the token and signing key through `SPRING_CONFIG_IMPORT`'s config trees, so swapping the image is
# the whole change. What it cannot be is the composition's `agent-work-dir`, which runs `sh` from the
# agent's image: there is none here (scripts/composition-scan-check.sh, AGENT_WORK_DIR_IMAGE).
FROM rust:1.99.1-alpine3.22@sha256:2b3b5cdd9112f19366d21b94541ffcd3d58bf838f696451a0d50c8032088cb15 AS build
# libssh2's vendored OpenSSL is built from source: a compiler, perl and make. cargo-auditable writes
# the dependency list into the binary, which is what lets Syft and Grype see what a static binary
# links — without it they find no package, and "no vulnerability" would mean "nothing looked at".
RUN apk add --no-cache musl-dev perl make linux-headers \
 && cargo install --locked cargo-auditable@0.7.4
WORKDIR /src
COPY . .
# The musl targets link statically by default; asking for it in RUSTFLAGS would also apply it to the
# proc-macros, which then cannot be built.
ENV SOURCE_DATE_EPOCH=0 \
    RUSTFLAGS="--remap-path-prefix=/src=. --remap-path-prefix=/usr/local/cargo=cargo"
RUN cargo auditable build --release --locked -p vectispire-agent \
 && cp target/release/vectispire-agent /vectispire-agent
# The directories the final image needs, their owner and mode set here: `scratch` has no program to set
# them, and `COPY --chmod` leaves a directory's own mode alone (measured: /tmp came out 0755). `/tmp` as
# Alpine has it; the home the user's, 0700 — the Java image's is 0777 only because Jib cannot set an owner.
RUN mkdir -p /rootfs/tmp /rootfs/home/vectispire \
 && chmod 1777 /rootfs/tmp && chmod 0700 /rootfs/home/vectispire && chown 1000:1000 /rootfs/home/vectispire

FROM scratch
# checkov:skip=CKV_DOCKER_2: the agent listens on nothing — it reaches the control plane by outbound
# long-polling (decision 0003) — so there is no port to probe, and `scratch` holds no program to run.
COPY --from=build /vectispire-agent /vectispire-agent
COPY --from=build /rootfs/ /
ENV HOME=/home/vectispire
USER 1000:1000
ENTRYPOINT ["/vectispire-agent"]
