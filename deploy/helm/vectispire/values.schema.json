{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Read by helm install, upgrade, lint and template before any template renders: a misspelt key, a wrong type or an image without a digest is refused before anything reaches the cluster. The guards that depend on several values together (an Ingress without trustedProxies, agents without their nodes...) stay in _helpers.tpl, whose messages give the reason. Free maps (annotations, labels, selectors, resources, env) stay open; every level of the chart's own keys is closed, since a typo there is otherwise a default silently kept.",
  "title": "Vectispire chart values",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "database", "secrets"],
  "definitions": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "pinnedImage": {
      "$comment": "A full reference, by digest: repository[:tag]@sha256:<64 hex>.",
      "type": "string",
      "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "pattern": "^[^:@\\s]+(:[0-9]+)?(/[^:@\\s]+)*$" },
        "tag": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$" },
        "digest": { "$ref": "#/definitions/digest" },
        "pullPolicy": { "$ref": "#/definitions/pullPolicy" }
      }
    },
    "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
    "secretName": {
      "$comment": "Empty, or a Secret's name (DNS subdomain).",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$"
    },
    "requiredSecretName": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$"
    },
    "secretKey": { "type": "string", "minLength": 1, "pattern": "^[-._a-zA-Z0-9]+$" },
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secretName": { "$ref": "#/definitions/secretName" },
        "key": { "$ref": "#/definitions/secretKey" }
      }
    },
    "requiredSecretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretName", "key"],
      "properties": {
        "secretName": { "$ref": "#/definitions/requiredSecretName" },
        "key": { "$ref": "#/definitions/secretKey" }
      }
    },
    "namespace": {
      "$comment": "Empty, or a namespace's name (DNS label).",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "quantity": {
      "$comment": "A Kubernetes quantity: 1Gi, 500m, 2.",
      "type": ["string", "integer"],
      "pattern": "^[0-9]+(\\.[0-9]+)?([EPTGMK]i|[numkMGTPE])?$",
      "minimum": 0
    },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "ipv4Cidr": {
      "type": "string",
      "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/([0-9]|[12][0-9]|3[0-2])$"
    },
    "absolutePath": { "type": "string", "pattern": "^/" },
    "stringMap": {
      "$comment": "Labels, annotations, selectors: every value a string. An unquoted true or 120 is refused by Kubernetes at apply, after the review.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "objectList": { "type": "array", "items": { "type": "object" } },
    "freeObject": { "type": "object" },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "$ref": "#/definitions/quantity" },
        "storageClassName": { "type": "string" }
      }
    }
  },
  "properties": {
    "global": {
      "$comment": "Helm's own, handed to every chart; the chart reads nothing from it.",
      "type": "object"
    },
    "image": { "$ref": "#/definitions/image" },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "user", "password"],
      "properties": {
        "url": { "type": "string", "pattern": "^jdbc:" },
        "user": { "type": "string", "minLength": 1 },
        "password": { "$ref": "#/definitions/requiredSecretRef" },
        "trustStore": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": { "$ref": "#/definitions/secretName" },
            "key": { "$ref": "#/definitions/secretKey" },
            "mountPath": { "$ref": "#/definitions/absolutePath" }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encryptionKey"],
      "properties": {
        "encryptionKey": { "$ref": "#/definitions/requiredSecretRef" },
        "bootstrapPassword": { "$ref": "#/definitions/secretRef" },
        "signingKey": { "$ref": "#/definitions/secretRef" },
        "oidcClientSecret": { "$ref": "#/definitions/secretRef" },
        "previousEncryptionKeys": { "$ref": "#/definitions/secretRef" },
        "mailPassword": { "$ref": "#/definitions/secretRef" }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "username": { "type": "string", "minLength": 1 } }
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "issuer": { "type": "string" } }
    },
    "publicUrl": { "type": "string" },
    "mail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string" },
        "port": { "$ref": "#/definitions/port" },
        "from": { "type": "string" },
        "username": { "type": "string" },
        "starttls": { "type": "boolean" }
      }
    },
    "trustedProxies": { "type": "string" },
    "trustedProxiesWithoutNetworkPolicy": { "type": "boolean" },
    "extraEnv": { "$ref": "#/definitions/env" },
    "auditMirror": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "$ref": "#/definitions/quantity" },
        "storageClassName": { "type": "string" },
        "accessMode": { "type": "string", "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany"] }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "$ref": "#/definitions/port" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "secretName": { "$ref": "#/definitions/secretName" } }
        },
        "allowPlainHttp": { "type": "boolean" },
        "stickySessions": { "type": "boolean" },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "resources": { "$ref": "#/definitions/freeObject" },
    "tmpSize": { "$ref": "#/definitions/quantity" },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": { "$ref": "#/definitions/probe" },
        "liveness": { "$ref": "#/definitions/probe" },
        "readiness": { "$ref": "#/definitions/probe" }
      }
    },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": { "$ref": "#/definitions/objectList" },
    "affinity": { "$ref": "#/definitions/freeObject" },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "$ref": "#/definitions/objectList" },
        "restrictEgress": { "type": "boolean" },
        "egress": { "$ref": "#/definitions/objectList" }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "$ref": "#/definitions/namespace" },
        "createNamespace": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "controlPlaneUrl": { "type": "string" },
        "token": { "$ref": "#/definitions/secretRef" },
        "signingKey": { "$ref": "#/definitions/secretRef" },
        "trustStore": { "$ref": "#/definitions/secretRef" },
        "knownHosts": { "type": "string" },
        "pluginRegistry": { "type": "string" },
        "pluginSignatureRequired": { "type": "boolean" },
        "extraEnv": { "$ref": "#/definitions/env" },
        "resources": { "$ref": "#/definitions/freeObject" },
        "executor": { "type": "string", "enum": ["dind", "kubernetes"] },
        "kubernetes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scansNamespace": { "$ref": "#/definitions/namespace" },
            "createNamespace": { "type": "boolean" },
            "acknowledgeExistingNamespace": { "type": "boolean" },
            "startTimeout": { "type": ["string", "integer"], "minLength": 1 },
            "scanCpuMillis": { "type": "integer", "minimum": 1 },
            "scanMemoryMiB": { "type": "integer", "minimum": 1 },
            "matcherCache": { "$ref": "#/definitions/claim" },
            "admissionPolicy": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "acknowledgeUnpinnedScanPods": { "type": "boolean" }
              }
            },
            "apiServer": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cidrs": { "type": "array", "items": { "$ref": "#/definitions/ipv4Cidr" } },
                "ports": { "type": "array", "items": { "$ref": "#/definitions/port" } }
              }
            }
          }
        },
        "workDir": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": { "$ref": "#/definitions/absolutePath" },
            "sizeLimit": { "$ref": "#/definitions/quantity" }
          }
        },
        "dind": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "variant": { "type": "string", "enum": ["privileged", "rootless"] },
            "privileged": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "image": { "$ref": "#/definitions/pinnedImage" } }
            },
            "rootless": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "image": { "$ref": "#/definitions/pinnedImage" },
                "acknowledgeUnreadableWorkspaces": { "type": "boolean" },
                "securityContext": { "$ref": "#/definitions/freeObject" }
              }
            },
            "resources": { "$ref": "#/definitions/freeObject" },
            "imageCache": { "$ref": "#/definitions/claim" },
            "dataSizeLimit": { "$ref": "#/definitions/quantity" }
          }
        },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "$ref": "#/definitions/objectList" },
        "affinity": { "$ref": "#/definitions/freeObject" },
        "acknowledgeSharedNodes": { "type": "boolean" },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "excludeCidrs": { "type": "array", "items": { "$ref": "#/definitions/ipv4Cidr" } },
            "acknowledgeClusterReachable": { "type": "boolean" },
            "allowTo": {
              "$comment": "Each entry is one NetworkPolicy peer and its ports. An entry without a peer, without ports or with a port left null is the chart's own guard's to refuse, with the reason; null is let through for it.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "ipBlock": { "type": "object" },
                  "namespaceSelector": { "type": "object" },
                  "podSelector": { "type": "object" },
                  "ports": {
                    "type": ["array", "null"],
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "port": { "type": ["integer", "string", "null"] },
                        "protocol": { "type": "string", "enum": ["TCP", "UDP", "SCTP"] },
                        "endPort": { "$ref": "#/definitions/port" }
                      }
                    }
                  }
                }
              }
            },
            "dnsTo": { "$ref": "#/definitions/objectList" }
          }
        }
      }
    }
  }
}
