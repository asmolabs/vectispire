{
    "name": "@zanshin/backend",
    "version": "0.1.0",
    "description": "Plan de contrôle Zanshin : API d'administration, cycle de vie des problèmes, file de scans et protocole d'agent.",
    "private": true,
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "//test:integration": "testcontainers demarre la base ; --runInBand car les suites la partagent",
        "test:integration": "jest --runInBand --config jest.integration.config.js",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "test:integration:mysql": "ZANSHIN_DB_DIALECT=mysql npm run test:integration",
        "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/persistence/data-source.ts",
        "migration:run": "typeorm-ts-node-commonjs migration:run -d src/persistence/data-source.ts",
        "//test:integration:mysql": "un seul ZANSHIN_DB_DIALECT : les entites et le harnais doivent lire le meme",
        "//test:integration:both": "les deux moteurs : un defaut de portabilite ne se voit qu'en executant les deux",
        "test:integration:both": "npm run test:integration && npm run test:integration:mysql",
        "//agent": "l'agent distant : meme ScanRunner que le travailleur integre, aucun acces a la base",
        "agent": "node dist/agent/main.js",
        "agent:dev": "ts-node -r tsconfig-paths/register src/agent/main.ts"
    },
    "dependencies": {
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.0.1",
        "@nestjs/platform-express": "^11.0.1",
        "@nestjs/schedule": "^6.0.0",
        "@nestjs/swagger": "^11.2.0",
        "@nestjs/typeorm": "^11.0.0",
        "bcryptjs": "^3.0.2",
        "helmet": "^8.1.0",
        "mysql2": "^3.23.3",
        "nestjs-zod": "^4.3.1",
        "pg": "^8.16.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "typeorm": "^0.3.27",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@testcontainers/mysql": "^12.1.0",
        "@types/bcryptjs": "^3.0.0",
        "@types/express": "^5.0.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.0.0",
        "@types/supertest": "^7.0.0",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "globals": "^17.0.0",
        "jest": "^30.0.0",
        "prettier": "^3.4.2",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
