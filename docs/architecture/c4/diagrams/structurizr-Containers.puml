@startuml
title <size:24>Container View: Vectispire Platform</size>\n<size:24>Level 2: Container Diagram showing frontend, backend, database, Docker daemon, and agents</size>

set separator none
top to bottom direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Container
  .Element-RWxlbWVudCxDb250YWluZXI= {
    BackgroundColor: #438dd5;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Database
  .Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U= {
    BackgroundColor: #438dd5;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #08427b;
    LineColor: #052e56;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0= {
    BackgroundColor: #1168bd;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Vectispire Platform
  .Boundary-VmVjdGlzcGlyZSBQbGF0Zm9ybQ== {
    BackgroundColor: #ffffff;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

person "==Security Analyst / Admin\n<size:16>[Person]</size>\n\nMonitors posture, triages vulnerabilities, configures compliance policies and team access." <<Element-RWxlbWVudCxQZXJzb24=>> as SecurityAnalystAdmin
person "==Software Developer\n<size:16>[Person]</size>\n\nViews repository findings, inspects SCA/Secrets/SAST issues, and remediates vulnerabilities." <<Element-RWxlbWVudCxQZXJzb24=>> as SoftwareDeveloper
person "==CI/CD Pipeline (Jenkins / GitHub Actions / GitLab CI)\n<size:16>[Person]</size>\n\nQueries the Quality Gate API (POST /api/v1/gate) to enforce security compliance before deployment." <<Element-RWxlbWVudCxQZXJzb24=>> as CICDPipelineJenkinsGitHubActionsGitLabCI
rectangle "==External Threat Feeds\n<size:16>[Software System]</size>\n\nPublic threat intelligence sources (CISA KEV, EPSS, endoflife.date)." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as ExternalThreatFeeds
rectangle "==Notification Systems\n<size:16>[Software System]</size>\n\nMicrosoft Teams, Email gateways, and signed HTTP webhooks." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as NotificationSystems

rectangle "Vectispire Platform\n<size:16>[Software System]</size>" <<Boundary-VmVjdGlzcGlyZSBQbGF0Zm9ybQ==>> {
  database "==Database Engine\n<size:16>[Container: PostgreSQL / MySQL / MariaDB / SQLite (Flyway Migrations)]</size>\n\nStores targets, scans, findings, issues, VEX triage history, audit logs, and system settings." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as VectispirePlatform.DatabaseEngine
  rectangle "==Docker Daemon & Scanners\n<size:16>[Container: Docker Engine / ContainerRunner]</size>\n\nRuns isolated ephemeral containers for SCA, Secrets, IaC, and SAST analysis." <<Element-RWxlbWVudCxDb250YWluZXI=>> as VectispirePlatform.DockerDaemonScanners
  rectangle "==Vectispire Remote Agent\n<size:16>[Container: Spring Boot / Java 25]</size>\n\nExecutes scans on remote worker nodes using HTTP long-polling." <<Element-RWxlbWVudCxDb250YWluZXI=>> as VectispirePlatform.VectispireRemoteAgent
  rectangle "==Angular Frontend UI\n<size:16>[Container: Angular 21 / Optimus UI / TypeScript]</size>\n\nProvides security overview, repository posture, compliance matrices, issue triage, and administration interface." <<Element-RWxlbWVudCxDb250YWluZXI=>> as VectispirePlatform.AngularFrontendUI
  rectangle "==Spring Boot Control Plane\n<size:16>[Container: Spring Boot 4.1 / JDK 25]</size>\n\nManages scan scheduling, issue lifecycle, VEX triage, policy gate evaluations, and audit logging." <<Element-RWxlbWVudCxDb250YWluZXI=>> as VectispirePlatform.SpringBootControlPlane
}

SecurityAnalystAdmin --> VectispirePlatform.AngularFrontendUI <<Relationship-UmVsYXRpb25zaGlw>> : "Uses for triage, compliance inspection, and system administration\n<size:16>[HTTPS]</size>"
SoftwareDeveloper --> VectispirePlatform.AngularFrontendUI <<Relationship-UmVsYXRpb25zaGlw>> : "Views findings and remediates security issues\n<size:16>[HTTPS]</size>"
CICDPipelineJenkinsGitHubActionsGitLabCI --> VectispirePlatform.SpringBootControlPlane <<Relationship-UmVsYXRpb25zaGlw>> : "Evaluates Quality Gate verdicts (POST /api/v1/gate)\n<size:16>[HTTP/HTTPS (API Key)]</size>"
VectispirePlatform.AngularFrontendUI --> VectispirePlatform.SpringBootControlPlane <<Relationship-UmVsYXRpb25zaGlw>> : "Sends API requests & fetches posture state\n<size:16>[JSON / REST API over HTTP]</size>"
VectispirePlatform.SpringBootControlPlane --> VectispirePlatform.DatabaseEngine <<Relationship-UmVsYXRpb25zaGlw>> : "Reads & writes domain entities, scans, issues, and audit logs\n<size:16>[JDBC / JPA Hibernate]</size>"
VectispirePlatform.SpringBootControlPlane --> VectispirePlatform.DockerDaemonScanners <<Relationship-UmVsYXRpb25zaGlw>> : "Launches ephemeral scanner containers (Syft, Grype, Gitleaks, Betterleaks, Checkov, Semgrep)\n<size:16>[Docker Socket / ContainerRunner]</size>"
VectispirePlatform.SpringBootControlPlane --> ExternalThreatFeeds <<Relationship-UmVsYXRpb25zaGlw>> : "Enriches vulnerabilities with KEV status, EPSS scores, and EOL metadata\n<size:16>[HTTPS]</size>"
VectispirePlatform.SpringBootControlPlane --> NotificationSystems <<Relationship-UmVsYXRpb25zaGlw>> : "Dispatches real-time alerts & outbox messages\n<size:16>[HTTP Webhooks / SMTP]</size>"
VectispirePlatform.VectispireRemoteAgent --> VectispirePlatform.SpringBootControlPlane <<Relationship-UmVsYXRpb25zaGlw>> : "Fetches scan tasks via HTTP Long-Polling (GET /api/v1/agents/jobs)\n<size:16>[HTTP/REST API (Agent Key)]</size>"
VectispirePlatform.VectispireRemoteAgent --> VectispirePlatform.DockerDaemonScanners <<Relationship-UmVsYXRpb25zaGlw>> : "Executes analysis containers on remote worker machine\n<size:16>[Docker Socket]</size>"

@enduml