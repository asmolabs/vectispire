rectangle "Vectispire Platform\n<size:16>[Software System]</size>" <<Boundary-VmVjdGlzcGlyZSBQbGF0Zm9ybQ==>> {
  rectangle "Spring Boot Control Plane\n<size:16>[Container: Spring Boot 4.1 / JDK 25]</size>" <<Boundary-U3ByaW5nIEJvb3QgQ29udHJvbCBQbGFuZQ==>> {
    rectangle "==IssueSync Service\n<size:16>[Component: Java / IssueSyncService]</size>\n\nCalculates issue fingerprints (SHA-256) and reconciles state across scans." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as VectispirePlatform.SpringBootControlPlane.IssueSyncService
    rectangle "==Compliance Service\n<size:16>[Component: Java / ComplianceService]</size>\n\nEvaluates NIS 2, DORA, ISO 27001, PCI-DSS frameworks at global & per-repo levels." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as VectispirePlatform.SpringBootControlPlane.ComplianceService
    rectangle "==PolicyGate Service\n<size:16>[Component: Java / PolicyGate]</size>\n\nEvaluates Quality Gate rules against target issue posture." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as VectispirePlatform.SpringBootControlPlane.PolicyGateService
    rectangle "==AuditLog Service\n<size:16>[Component: Java / AuditLogService]</size>\n\nMaintains SHA-256 hash-chained immutable audit records." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as VectispirePlatform.SpringBootControlPlane.AuditLogService
    rectangle "==Encryption Service\n<size:16>[Component: Java / EncryptionService]</size>\n\nEncrypts SSH deployment keys at rest using AES-256-GCM." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as VectispirePlatform.SpringBootControlPlane.EncryptionService
    rectangle "==API Controllers Layer\n<size:16>[Component: Spring REST Controllers]</size>\n\nHandles HTTP endpoints (/api/v1/compliance, /api/v1/gate, /api/v1/scans, /api/v1/issues)." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as VectispirePlatform.SpringBootControlPlane.APIControllersLayer
    rectangle "==ScanRunner Engine\n<size:16>[Component: Java / ScanRunner]</size>\n\nOrchestrates repository clone and scanner container invocations." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as VectispirePlatform.SpringBootControlPlane.ScanRunnerEngine
    rectangle "==ScanIngestor Service\n<size:16>[Component: Java / ScanIngestor]</size>\n\nNormalizes raw scanner outputs into findings and deduplicates secrets." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as VectispirePlatform.SpringBootControlPlane.ScanIngestorService
  }

  database "==Database Engine\n<size:16>[Container: PostgreSQL / MySQL / MariaDB / SQLite (Flyway Migrations)]</size>\n\nStores targets, scans, findings, issues, VEX triage history, audit logs, and system settings." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as VectispirePlatform.DatabaseEngine
  rectangle "==Docker Daemon & Scanners\n<size:16>[Container: Docker Engine / ContainerRunner]</size>\n\nRuns isolated ephemeral containers for SCA, Secrets, IaC, and SAST analysis." <<Element-RWxlbWVudCxDb250YWluZXI=>> as VectispirePlatform.DockerDaemonScanners
}

