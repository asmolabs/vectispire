System(ExternalThreatFeeds, "External Threat Feeds", $descr="Public threat intelligence sources (CISA KEV, EPSS, endoflife.date).", $tags="", $link="")
System(NotificationSystems, "Notification Systems", $descr="Microsoft Teams, Email gateways, and signed HTTP webhooks.", $tags="", $link="")

System_Boundary("VectispirePlatform_boundary", "Vectispire Platform", $tags="") {
  Container_Boundary("VectispirePlatform.SpringBootControlPlane_boundary", "Spring Boot Control Plane", $tags="") {
    Component(VectispirePlatform.SpringBootControlPlane.audit, "audit", $techn="Spring Modulith module", $descr="The audit log — writing it, its mirror, reading it back and judging its chain — and RequestActor.", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.checklists, "checklists", $techn="Spring Modulith module", $descr="Security checklists — the organisation's templates, their versions and their items, imported from its own workbooks, and each project's checklist answered against them by people — and on its measured lines by Vectispire, from the scans and imports it is told of (RepositoryScanned, RepositoryReported, ports of scanning and plugins it implements) — with its proofs, its submission and its sign-off, and the measurements a line's rule takes of the project (decision 0032).", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.compliance, "compliance", $techn="Spring Modulith module", $descr="Frameworks, statement of applicability, evidence, OWASP.", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.config, "config", $techn="Spring Modulith module", $descr="The application's configuration, outside every domain module.", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.crypto, "crypto", $techn="Spring Modulith module", $descr="Encryption at rest, the key's sources, Vault, the document signing key.", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.exports, "exports", $techn="Spring Modulith module", $descr="VEX, CSAF, CycloneDX, attestation, the export documents.", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.gate, "gate", $techn="Spring Modulith module", $descr="The gate, its register, its stored policies and ActiveGatePolicies.", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.inventory, "inventory", $techn="Spring Modulith module", $descr="What targets are made of: components, SBOM diff, blast radius, licences, API contracts.", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.issues, "issues", $techn="Spring Modulith module", $descr="Sync, triage, decisions, SLA, history, the exceptions register, VEX import.", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.maintenance, "maintenance", $techn="Spring Modulith module", $descr="The periodic jobs' port: MaintenanceTask, and the tick that runs a cadence's tasks in their order.", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.notifications, "notifications", $techn="Spring Modulith module", $descr="What a scan's delta says, and the channels that say it.", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.outbound, "outbound", $techn="Spring Modulith module", $descr="The one door out: PinnedHttpSender, OutboundJson, OutboundPost, OutboundDownload, the guard's configuration.", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.outbox, "outbox", $techn="Spring Modulith module", $descr="The relay: OutboxService, and the two contracts it dispatches to, OutboxHandler and NotificationChannel, with GoneDestinationException.", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.platform, "platform", $techn="Spring Modulith module", $descr="The shell: the settings screen, which composes the credentials and checks of ai, tickets, notifications and access; the audit-log and crypto routes the foundation may not keep (they need access's markers, and access uses the foundation); the exception handler, the SPA forwarding and the OpenAPI configuration.", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.plugins, "plugins", $techn="Spring Modulith module", $descr="Plugins — third-party analysers run as containers, emitting SARIF — their activation per project, and SARIF imported from declared internal sources (decision 0017, amended).", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.posture, "posture", $techn="Spring Modulith module", $descr="Figures of risk: dashboard, scorecards, debt, quality, remediation, attack paths, the weekly digest.", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.reporting, "reporting", $techn="Spring Modulith module", $descr="The PDF pagination four domains' reports share (ReportCursor): how a page is laid out, not what it says.", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.rules, "rules", $techn="Spring Modulith module", $descr="Rule sets, the upstream catalogue, rule coverage.", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.scanning, "scanning", $techn="Spring Modulith module", $descr="The queue, dispatch, ingest, the built-in worker, scheduling, scan reads, retention.", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.settings, "settings", $techn="Spring Modulith module", $descr="The deployment's configuration: SettingsService, the first-install defaults, and what Vectispire says about itself (ProductVersion, ExportProperties, BrandingProperties).", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.siem, "siem", $techn="Spring Modulith module", $descr="The security event stream and its delivery through the outbox (decision 0025).", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.targets, "targets", $techn="Spring Modulith module", $descr="Repositories, containers, solutions and projects, clone credentials, deletion — and the TargetDeleted event and TargetPurge phases every owner of a target's rows listens to.", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.threatintel, "threatintel", $techn="Spring Modulith module", $descr="KEV/EPSS feeds, enrichment, end of life.", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.tickets, "tickets", $techn="Spring Modulith module", $descr="The tracker client, the ticket links, the tracker's webhook and the ticket sweep.", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.access, "access", $techn="Spring Modulith module", $descr="Accounts, teams, visibility and the row guard, sessions, sign-in flows, second factors, OIDC, SCIM, API keys, bootstrap — and, in web.security, the vocabulary every module's routes use.", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.agents, "agents", $techn="Spring Modulith module", $descr="Agent administration, the agent row, and the agent protocol.", $tags="", $link="")
    Component(VectispirePlatform.SpringBootControlPlane.ai, "ai", $techn="Spring Modulith module", $descr="The model review and the advisor.", $tags="", $link="")
  }

  Container(VectispirePlatform.DockerDaemonScanners, "Docker Daemon & Scanners", $techn="Docker Engine / ContainerRunner", $descr="Runs isolated ephemeral containers for SCA, Secrets, IaC, and SAST analysis.", $tags="", $link="")
}

