{
    "name": "zanshin",
    "version": "0.1.0",
    "private": true,
    "description": "Zanshin — analyse de sécurité applicative. Migration de la pile Python/Reflex vers NestJS + Angular (voir docs/migration-nestjs-angular.md).",
    "workspaces": [
        "backend",
        "frontend"
    ],
    "engines": {
        "node": ">=22 <25"
    },
    "scripts": {
        "build": "npm run build --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "lint": "npm run lint --workspaces --if-present",
        "start:backend": "npm run start:dev --workspace @zanshin/backend",
        "start:frontend": "npm run start --workspace @zanshin/frontend"
    },
    "devDependencies": {
        "jsdom": "^26.1.0",
        "vitest": "^3.2.7"
    }
}
