# Vectispire Remote Agent: dials out to the control plane and runs scanner containers locally.
#
#   docker build -f Dockerfile.agent -t vectispire-agent .
#   docker run --rm \
#     -e VECTISPIRE_URL=http://control-plane:3180 \
#     -e VECTISPIRE_AGENT_TOKEN=... \
#     -v /var/run/docker.sock:/var/run/docker.sock \
#     vectispire-agent

# --- Build Stage -------------------------------------------------------------------------
FROM eclipse-temurin:25-jdk-alpine AS build

WORKDIR /src
COPY vectispire-java/gradle/ gradle/
COPY vectispire-java/gradlew vectispire-java/settings.gradle.kts vectispire-java/build.gradle.kts ./
COPY vectispire-java/buildSrc/ buildSrc/
RUN mkdir -p vectispire-common vectispire-core vectispire-agent && ./gradlew --no-daemon help

COPY vectispire-java/ ./
RUN ./gradlew --no-daemon :vectispire-agent:bootJar -x test

# --- Runtime Stage -----------------------------------------------------------------------
FROM eclipse-temurin:25-jre-alpine

RUN apk add --no-cache git openssh-client ca-certificates

WORKDIR /app
COPY --from=build /src/vectispire-agent/build/libs/vectispire-agent.jar app.jar
COPY LICENSE NOTICE ./

RUN addgroup -S vectispire && adduser -S -G vectispire vectispire
USER vectispire

ENTRYPOINT ["java", "-jar", "app.jar"]
