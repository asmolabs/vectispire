# Veriscape Remote Agent: dials out to the control plane and runs scanner containers locally.
#
#   docker build -f Dockerfile.agent -t veriscape-agent .
#   docker run --rm \
#     -e VERISCAPE_URL=http://control-plane:3180 \
#     -e VERISCAPE_AGENT_TOKEN=... \
#     -v /var/run/docker.sock:/var/run/docker.sock \
#     veriscape-agent

# --- Build Stage -------------------------------------------------------------------------
FROM eclipse-temurin:25-jdk-alpine AS build

WORKDIR /src
COPY veriscape-java/gradle/ gradle/
COPY veriscape-java/gradlew veriscape-java/settings.gradle.kts veriscape-java/build.gradle.kts ./
COPY veriscape-java/buildSrc/ buildSrc/
RUN mkdir -p veriscape-common veriscape-core veriscape-agent && ./gradlew --no-daemon help

COPY veriscape-java/ ./
RUN ./gradlew --no-daemon :veriscape-agent:bootJar -x test

# --- Runtime Stage -----------------------------------------------------------------------
FROM eclipse-temurin:25-jre-alpine

RUN apk add --no-cache git openssh-client ca-certificates

WORKDIR /app
COPY --from=build /src/veriscape-agent/build/libs/veriscape-agent.jar app.jar
COPY LICENSE NOTICE ./

RUN addgroup -S veriscape && adduser -S -G veriscape veriscape
USER veriscape

ENTRYPOINT ["java", "-jar", "app.jar"]
