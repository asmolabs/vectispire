# L'agent distant de Zanshin.
#
# Il n'embarque **ni base ni interface** : seulement de quoi parler le protocole d'agent et
# lancer des conteneurs de scanner. Ce qu'il n'a pas est le point — un agent avec une
# connexion à la base aurait aussi besoin d'ENCRYPTION_KEY, c'est-à-dire de quoi déchiffrer
# toutes les clés de déploiement que Zanshin détient.
#
#   docker build -f Dockerfile.agent -t zanshin-agent .
#   docker run --rm \
#     -e ZANSHIN_URL=https://zanshin.interne \
#     -e ZANSHIN_AGENT_TOKEN=zsk_... \
#     -v /var/run/docker.sock:/var/run/docker.sock \
#     zanshin-agent
#
# **Le socket Docker est monté, et c'est le compromis à connaître.** L'agent lance les
# scanners en conteneurs frères ; y accéder équivaut à un accès root sur l'hôte. C'est
# précisément pourquoi on déporte ce travail sur une machine qui ne sert pas l'interface.

FROM node:24-alpine AS build

WORKDIR /app

# Les manifestes d'abord : la couche d'installation ne se reconstruit que lorsque les
# dépendances changent, pas à chaque modification de source.
COPY package.json package-lock.json ./
COPY backend/package.json backend/
COPY frontend/package.json frontend/
RUN npm ci --workspace backend --include-workspace-root

COPY backend/ backend/
RUN npm --workspace backend run build

# --- Image finale ---
FROM node:24-alpine

# `git` est indispensable : l'agent clone les dépôts qu'il scanne. Le client Docker ne
# l'est pas — l'agent parle au démon par le socket, avec la bibliothèque Node.
RUN apk add --no-cache git openssh-client ca-certificates

WORKDIR /app

COPY package.json package-lock.json ./
COPY backend/package.json backend/
# `--omit=dev` : ni NestJS CLI, ni Jest, ni TypeScript dans l'image qui tourne.
RUN npm ci --workspace backend --include-workspace-root --omit=dev && npm cache clean --force

COPY --from=build /app/backend/dist backend/dist

# **Les règles Semgrep ne sont pas compilées**, ce sont des fichiers YAML : `tsc` les
# ignore, et sans cette copie l'étape SAST tournerait sans aucune règle — donc sans aucun
# constat, ce qui se lirait « code propre ».
COPY backend/src/scanning/rules backend/dist/scanning/rules

# Un utilisateur non privilégié dans le conteneur. Il reste membre du groupe qui possède
# le socket Docker sur l'hôte, ce que le déploiement doit accorder (`--group-add`).
USER node

ENV NODE_ENV=production

# Pas de `HEALTHCHECK` : un agent n'écoute sur aucun port et n'a rien à interroger. Sa
# santé se lit sur l'écran /agents du plan de contrôle, qui sait quand il s'est annoncé
# pour la dernière fois — et c'est la seule vue qui compte, puisqu'elle distingue
# « désactivé » de « muet ».
CMD ["node", "backend/dist/agent/main.js"]
