# Ce projet s'approvisionne directement au registre npm public.
#
# **Pourquoi, alors qu'un proxy d'entreprise est configuré au niveau utilisateur.**
# Deux raisons, la seconde étant la plus importante :
#
# 1. Le proxy n'est joignable que depuis le réseau interne. Une coupure de VPN bloque
#    toute installation, ce qui est arrivé en plein travail.
# 2. **Surtout : `package-lock.json` enregistre l'URL de résolution de chaque paquet.**
#    Résolu à travers le proxy, il fige des adresses `nexus.civadis.be` — que le job CI,
#    qui tourne chez GitHub, ne peut pas atteindre. `npm ci` y échouerait sur chaque
#    paquet. Un lockfile n'est reproductible que si ses adresses le sont pour tout le
#    monde.
#
# Vectispire est un projet ouvert : ses dépendances doivent s'installer depuis n'importe
# où, sans appartenir à un réseau particulier.
registry=https://registry.npmjs.org/

# Le `.npmrc` utilisateur porte `force=true`, d'où le « Recommended protections
# disabled » à chaque commande. `--force` fait passer outre des garde-fous — conflits de
# dépendances de pair, écrasements — dont ce projet n'a aucune raison de se priver, et
# encore moins un outil qui audite des chaînes d'approvisionnement.
force=false
