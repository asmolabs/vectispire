# ==============================================================================
# Zanshin — Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=zanshin
POSTGRES_USER=zanshin
POSTGRES_PASSWORD=change_this_in_production_password

# Control Plane HTTP Port (accessible on host)
ZANSHIN_PORT=8000

# 32-byte Base64-encoded Encryption Key (AES-256-GCM)
# Generate with: openssl rand -base64 32
ZANSHIN_ENCRYPTION_KEY=dGVzdC1lbmNyeXB0aW9uLWtleS0zMi1ieXRlcyEh

# Bootstrap Initial Administrator Account (applied on first startup when t_user is empty)
ZANSHIN_BOOTSTRAP_USERNAME=admin
ZANSHIN_BOOTSTRAP_PASSWORD=AdminZanshin2026!

# Built-in Worker (set false if delegating all scans to remote agents)
ZANSHIN_EMBEDDED_WORKER=true

# Remote Agent Configuration (used when running with profile: with-agent)
ZANSHIN_AGENT_TOKEN=
