# ==============================================================================
# Vectispire — Environment Configuration
# ==============================================================================
#
# Copy to `.env` and fill in every value marked CHANGE_ME. They are deliberately
# not valid: a placeholder that works is a default, and a default secret in a
# public repository is everyone's secret. `docker compose up` stops with
# "variable is not set" until the three required ones are real.
# ==============================================================================

# --- Database (MySQL) ---------------------------------------------------------
MYSQL_DATABASE=vectispire
MYSQL_USER=vectispire
# Generate with: openssl rand -base64 24
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# --- Control Plane ------------------------------------------------------------
# HTTP port published on the host.
VECTISPIRE_PORT=3180

# 32-byte Base64-encoded encryption key (AES-256-GCM).
# **This key decrypts every deployment SSH key and integration token the instance
# holds.** Generate your own and never share it between environments:
#   openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME

# Bootstrap administrator, applied on first startup while t_user is empty.
# The account is created with `mustChangePassword`, so this password is a
# one-time hand-off rather than a standing credential — it still must not be a
# value anybody else can read.
VECTISPIRE_BOOTSTRAP_USERNAME=admin
VECTISPIRE_BOOTSTRAP_PASSWORD=CHANGE_ME

# Built-in worker (set false if delegating all scans to remote agents).
VECTISPIRE_EMBEDDED_WORKER=true

# --- Network ------------------------------------------------------------------
# Address or CIDR of the reverse proxy / load balancer in front, comma-separated.
# Empty means "nothing in front": X-Forwarded-For is then ignored and the peer
# address is what the login rate limiter counts. Setting this wrong is worse than
# leaving it empty — a trusted proxy's header is taken at face value.
VECTISPIRE_TRUSTED_PROXIES=

# Group that owns /var/run/docker.sock on the host. The images run as an
# unprivileged user, so without membership every scan fails with "permission
# denied" on the daemon. Find it with: stat -c '%g' /var/run/docker.sock
DOCKER_SOCKET_GROUP=docker

# --- Remote Agent (profile: with-agent) ---------------------------------------
# Issued when enrolling the agent in the UI.
VECTISPIRE_AGENT_TOKEN=
